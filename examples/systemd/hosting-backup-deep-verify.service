[Unit]
Description=Deep-verify the latest received hosting backup inventory
After=docker.service hosting-backup-receiver.service
Requires=docker.service

[Service]
Type=oneshot
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/usr/bin/docker exec hosting-ui node /app/cli/deep-verify.js /srv/backups

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
